# VRCloud IDE
AUTH_USER=admin
AUTH_PASS=replace-with-a-long-random-password
AUTH_SECRET=replace-with-at-least-32-random-characters

# Akses langsung https://IP:PORT (sertifikat self-signed otomatis, atau TLS_CERT/TLS_KEY).
# HTTPS=false mengembalikan HTTP biasa.
HTTPS=true
COOKIE_SECURE=true
SESSION_MAX_AGE=604800
# TLS_CERT=
# TLS_KEY=
# TLS_SAN= nama atau IP tambahan, dipisah koma

# 0.0.0.0 agar https://IP-publik:PORT bisa dibuka dari luar.
HOST=0.0.0.0

# AI Agent. Pilih salah satu (atau keduanya, lalu pilih provider di panel AI):
#  - Cursor SDK:       isi CURSOR_API_KEY (Cursor Dashboard -> Integrations). Butuh Node.js >= 22.13.
#  - Anthropic Claude: isi ANTHROPIC_API_KEY (console.anthropic.com). Agent memakai tool
#                      workspace bawaan (baca/edit file, shell, pencarian, browser).
# AI_PROVIDER opsional: cursor | anthropic (default otomatis dari key yang tersedia).
CURSOR_API_KEY=
ANTHROPIC_API_KEY=
AI_PROVIDER=
# Model: "auto" = default provider (Cursor: auto; Anthropic: Claude Sonnet terbaru).
# Contoh Anthropic: claude-sonnet-4-5, claude-opus-4-1 (lihat daftar di tombol model).
AI_MODEL=auto

# Otomasi browser agent (navigate/click/type/screenshot/console/network via CDP).
# Otomatis mendeteksi Chrome / Edge / Chromium / Brave yang terpasang (Windows, Linux, macOS).
# Isi hanya bila ingin memaksa executable tertentu.
# VRCLOUD_BROWSER=/usr/bin/chromium
